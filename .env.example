# PostgreSQL Connection String
DATABASE_URL="postgresql://kabar_user:kabar_password@localhost:5432/kabar_bumi?schema=public"

# 32-Byte Secret Key for AES-256-GCM Field-Level PII Encryption (Base64 or random string)
DATA_ENCRYPTION_KEY="kabar_bumi_super_secret_encryption_key_change_in_production_32bytes"

# NextAuth / Auth.js Secret
NEXTAUTH_SECRET="kabar_bumi_nextauth_secret_session_key_random_string_32"
NEXTAUTH_URL="http://localhost:3000"

# Rate Limiting & Security
RATE_LIMIT_MAX_PER_MINUTE="10"
